# Google OAuth 2.0 Client ID (type: Web application), from Google Cloud
# Console > APIs & Services > Credentials. Used client-side only, for the
# "Backup & Sync" feature (Google Drive app-data storage) — never required
# to use the app itself. Add both http://localhost:3000 and your production
# URL to "Authorized JavaScript origins" on this client ID, and enable the
# Google Drive API and Google People API on the project. No redirect URI is
# needed — sign-in uses a popup token flow, not a redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-only Gemini API key, used by /api/quick-add/parse (the "Quick Add"
# AI assistant). Get one from https://aistudio.google.com/apikey. The app
# runs fine without this — Quick Add just won't work until it's set.
GEMINI_API_KEY=your-gemini-api-key

# Optional: overrides the default Gemini model used for Quick Add parsing.
# GEMINI_QUICK_ADD_MODEL=gemini-2.5-flash
